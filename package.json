{
	"name": "pi-provider-throttle",
	"version": "1.1.1",
	"description": "Per-provider LLM request throttling for the Pi coding agent — persistent seconds-between-calls pacing that prevents 429 Too Many Requests on rate-limited providers (e.g. NVIDIA NIM 40 RPM free tiers) while leaving unaffected providers untouched.",
	"license": "MIT",
	"author": "Carlos Duplar",
	"type": "module",
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"throttle",
		"throttling",
		"rate-limit",
		"rate-limiting",
		"429",
		"too-many-requests",
		"free-tier",
		"provider",
		"pacing",
		"nvidia",
		"nim",
		"llm",
		"rpm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/carlosduplar/pi-provider-throttle.git"
	},
	"homepage": "https://github.com/carlosduplar/pi-provider-throttle#readme",
	"bugs": {
		"url": "https://github.com/carlosduplar/pi-provider-throttle/issues"
	},
	"engines": {
		"node": ">=22.15.0"
	},
	"files": [
		"extensions",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "^1.3.0"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.99.2",
		"@types/node": "^24.7.2",
		"typebox": "^1.3.29",
		"typescript": "^5.9.3"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --experimental-strip-types --no-warnings --test \"test/*.test.ts\"",
		"prepublishOnly": "npm run typecheck && npm test"
	}
}
